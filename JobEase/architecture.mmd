    classDef backend fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#000;
    classDef external fill:#fff3e0,stroke:#fb8c00,stroke-width:2px,color:#000;
    classDef model fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#000;

    subgraph Frontend ["🟦 Frontend (React.js)"]
